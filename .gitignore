# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Env + secrets
.env
*.env
!.env.example

# Database
*.db
*.sqlite3

# Model weights (fetched, not committed - see backend/ml/README.md)
backend/ml/weights/*
!backend/ml/weights/.gitkeep
# Training runs and downloaded base weights (scripts/build_ppe_model.py)
backend/ml/runs/
yolo*.pt

# Runtime artefacts
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/storage/annotated/*
!backend/storage/annotated/.gitkeep

# Large demo media (keep one small sample if needed)
backend/data/samples/videos/*.mp4

# Node
node_modules/
dist/
.vite/

# Editors / OS / local tooling config
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Dataset track (data/). Downloads and generated output are rebuilt by data\run_data.bat and
# never committed; folder READMEs and .gitkeep files stay tracked so the layout survives a clone.
# The "!.../" lines re-include directories - git cannot un-ignore a file inside an ignored folder.
data/.venv/
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
!data/raw/**/README.md
data/out/**
!data/out/**/
!data/out/.gitkeep
# Daily CPCB readings via OpenAQ: the stations carry no licence in OpenAQ (licenses = null), so the
# values stay local until redistribution is confirmed. Rebuilt by: data\run_data.bat clean
data/reference/env_daily.csv

# Simulator API key (issued by `yii api-key/issue`) and its replay cache
scripts/.simulator.key
scripts/.cache/

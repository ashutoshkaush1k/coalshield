# The online database and file storage, for the commands the laptop runs against them
# (scripts\online.bat - docs/DEPLOYMENT.md). Copy this file to deploy\online.local.env (git-ignored)
# and fill in the values from the Supabase dashboard. Never commit the copy.

# Supabase > Connect > "Session pooler" (not "Direct": that one is IPv6 only; not "Transaction").
# Host looks like aws-0-ap-southeast-1.pooler.supabase.com, the user like postgres.abcdefghijklmnop
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_PERSISTENT=0

# Supabase > Project Settings > API: the project URL and the secret (service_role) key.
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=files

# The online server has no ai-service; the jobs use the PHP detectors (the same algorithms).
AI_ENGINE=php

# The dashboard's address on Vercel (only written into deploy\credentials.local.md).
ONLINE_SITE_URL=

# Copy to backend/.env and adjust.
APP_NAME="Smart Mine Governance API"
DEBUG=true

# SQLite for the prototype; swap this one line for a PostgreSQL URL later.
#
# Left unset on purpose. The default in app/core/config.py resolves to an ABSOLUTE path
# (backend/smartmine.db), so the seeder and the API open the same file no matter which
# directory they are launched from. A relative "sqlite:///./smartmine.db" here would make
# seed_db.py (run from the repo root) and uvicorn (run from backend/) use two different
# databases, and the dashboard would come up empty with no error.
# DATABASE_URL="postgresql+psycopg://user:pass@localhost/smartmine"

# Must be at least 32 bytes for HS256. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET="dev-only-secret-change-me-before-the-demo-32b+"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CV module
YOLO_WEIGHTS_PATH="ml/weights/ppe.pt"
DETECTION_CONFIDENCE=0.45
# Mandatory PPE on site. Add "mask" if dust masks are enforced; the model already detects them.
REQUIRED_PPE="helmet,vest"

# Compliance scoring (PRD 6.1) - tune these during development
WEIGHT_PPE=5
WEIGHT_ENV=3

# Sensor thresholds (PRD 4.2)
THRESHOLD_GAS_PPM=50
THRESHOLD_DUST_MGM3=10
THRESHOLD_TEMP_C=45

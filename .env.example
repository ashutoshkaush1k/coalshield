# Repo-root environment for the dataset track (data\run_data.bat).
# Copy to .env in the repo root and fill in only what you have. Every key is OPTIONAL:
# a source whose key is missing is skipped with a logged reason and a documented fallback
# (see data/MANUAL_STEPS.md). .env is gitignored - never commit real keys.
#
# The backend and frontend keep their own files (backend/.env, frontend/.env).

# OpenAQ API v3 - air quality near coalfields (source S09). Free key from openaq.org.
OPENAQ_API_KEY=

# Kaggle - only if a PPE evaluation dataset is taken from Kaggle (source S13, optional).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Roboflow - only if a PPE evaluation dataset is taken from Roboflow (source S13, optional).
ROBOFLOW_API_KEY=

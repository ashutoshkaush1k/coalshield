# CoalShield API settings. Copy to .env and fill in real values; .env is never committed.
YII_DEBUG=1
YII_ENV=dev

# PostgreSQL 16 + PostGIS (see docs/SETUP_WINDOWS.md)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=coalshield
DB_TEST_NAME=coalshield_test
DB_USER=coalshield
DB_PASSWORD=change-me

# JWT (HS256). Use a long random value, e.g. 64 hex characters.
JWT_SECRET=change-me-to-64-random-hex-characters
JWT_ISSUER=coalshield-api
JWT_TTL_HOURS=12

# Comma-separated origins allowed by CORS (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# bcrypt cost for password hashes (seed hashes every demo account at this cost)
PASSWORD_HASH_COST=10

# Where `yii seed <preset>` finds data\run_data.bat output (relative to api/)
DATA_OUT_DIR=../data/out

# Uploaded files: stored outside web/, size limit in bytes
FILE_STORAGE_DIR=@app/storage/files
FILE_MAX_BYTES=10485760

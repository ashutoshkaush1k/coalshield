# Yii2 API (api/serve.bat). The FastAPI prototype used VITE_API_BASE_URL=http://localhost:8000/api/v1;
# that variable is still read as a fallback for one release (PLAN Q5).
VITE_API_URL="http://localhost:8080/v1"

# Site footer (components/common/SiteFooter.jsx). Unset: the helpline shows masked (XXXXX XXXXX)
# and the email is a placeholder on the reserved .example domain.
# VITE_HELPLINE="1800 000 0000"
# VITE_SUPPORT_EMAIL="helpdesk@your-domain"

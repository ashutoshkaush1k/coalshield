# The online build (Vercel: npm run build:online - docs/DEPLOYMENT.md). Nothing secret here.
# VITE_API_URL is NOT set in this file: it is set in the Vercel project's environment variables
# (https://<service>.onrender.com/v1), and the build stops if it is missing.
# No VITE_DEMO_MODE: the login page shows no demo buttons and no demo password.

# "Starting server, about 1 minute" while the free API server wakes up.
VITE_WAKE_NOTICE=true
# The service worker and the installed app cover the field app (/field) only.
VITE_SW_SCOPE=/field
